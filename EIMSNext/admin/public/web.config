<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- ===== 原有配置 ===== -->
    <caching enabled="false" enableKernelCache="false" />
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- ===== HTTP 静态压缩 ===== -->
    <httpCompression
        minFileSizeForComp="1024"
        staticCompressionIgnoreHitFrequency="true"
        noCompressionForHttp10="false"
        noCompressionForProxies="false">
      <staticTypes>
        <!-- 必须先 clear：父级 applicationHost.config 已有同名条目，重复 add 会 500.19 -->
        <clear />
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/xml" enabled="true" />
        <add mimeType="application/xhtml+xml" enabled="true" />
        <add mimeType="application/atom+xml" enabled="true" />
        <add mimeType="application/xaml+xml" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <!-- 本身已是压缩格式，禁止重复压缩 -->
        <add mimeType="image/*" enabled="false" />
        <add mimeType="font/*" enabled="false" />
        <add mimeType="application/octet-stream" enabled="false" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- 防止代理/CDN 把 gzip 内容发给不支持压缩的客户端 -->
    <httpProtocol>
      <customHeaders>
        <remove name="Vary" />
        <add name="Vary" value="Accept-Encoding" />
      </customHeaders>
    </httpProtocol>

    <!-- 带 hash 的 js/css/图片：强缓存 1 年 -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>

  <!-- 入口 HTML：禁止缓存，保证发版后立即生效 -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- 运行期部署配置：禁止缓存，改完立刻生效 -->
  <location path="appSetting.prod.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
